# Plain HTTP on the local network. Turn on HTTPS before exposing this to the internet.
{
	auto_https off
}

:80 {
	# YouTube is allowed for the video albums only: its player script, the pictures of the videos, and the
	# player frame (the privacy-friendly domain). The frame carries its own referrer policy, because the
	# policy below sends no referrer and the player refuses to start without one.
	header {
		Content-Security-Policy "default-src 'self'; script-src 'self' https://www.youtube.com; style-src 'self'; img-src 'self' data: https://i.ytimg.com; connect-src 'self'; frame-src https://www.youtube-nocookie.com; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		-Server
	}

	handle /api/* {
		reverse_proxy backend:8080
	}

	root * /srv

	# The files under /assets carry a hash in their name, so a changed file is a new name and they can
	# be kept for a year. A name that does not exist falls through to the next block.
	@hashed {
		path /assets/*
		file
	}
	handle @hashed {
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	# index.html names the current scripts, so a browser must ask before reusing it; otherwise an open
	# app can keep running an old build after a deploy.
	handle {
		header Cache-Control no-cache
		try_files {path} /index.html
		file_server
	}
}
