# Copy to .env and replace every value. .env is ignored by Git; never commit it.
# Long random values can be generated with: openssl rand -base64 32

VOCABFLOW_DB_PASSWORD=
VOCABFLOW_DB_ROOT_PASSWORD=
VOCABFLOW_AUTH_SECRET=

# Anyone registering must enter this code.
VOCABFLOW_INVITE_CODE=

# 0.0.0.0 lets other devices on the network connect; 127.0.0.1 is this computer only.
VOCABFLOW_BIND_ADDRESS=0.0.0.0
VOCABFLOW_PORT=8088

# fake gives placeholder content. claude gives real content and needs an API key.
VOCABFLOW_ENRICHMENT_PROVIDER=fake
VOCABFLOW_ANTHROPIC_API_KEY=
VOCABFLOW_ENRICHMENT_DAILY_LIMIT=50
# The model that writes reading passages; word details use VOCABFLOW_ENRICHMENT_MODEL.
VOCABFLOW_READING_MODEL=claude-sonnet-5-5

# Daily reminders (Web Push). Leave empty to keep them off. scripts/generate_vapid_keys.sh mailto:you@example.com
# fills these three in. Reminders also need the app to be opened over https (see README).
VOCABFLOW_PUSH_PUBLIC_KEY=
VOCABFLOW_PUSH_PRIVATE_KEY=
VOCABFLOW_PUSH_SUBJECT=
